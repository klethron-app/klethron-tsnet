<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:fitsSystemWindows="true"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/live_instructions" />
        <Button android:id="@+id/start_node" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/start_node" />
        <TextView android:id="@+id/node_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/not_started"
            android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/authorize" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/authorize" android:enabled="false" />
        <Button android:id="@+id/login" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/login" android:enabled="false" />
        <Button android:id="@+id/logout" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/logout" android:enabled="false" />
        <Button android:id="@+id/pick_peer" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/pick_peer" android:enabled="false" />
        <EditText android:id="@+id/peer_host" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="@string/peer_host"
            android:inputType="textUri" android:importantForAutofill="no" />
        <EditText android:id="@+id/peer_port" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="@string/peer_port" android:inputType="number"
            android:text="@string/default_peer_port" android:importantForAutofill="no" />
        <CheckBox android:id="@+id/keep_open" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/keep_open" />
        <Button android:id="@+id/exchange" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/exchange" android:enabled="false" />
        <TextView android:id="@+id/result" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" />
    </LinearLayout>
</ScrollView>
